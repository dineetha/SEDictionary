{
  "manifest_version": 3,
  "name": "SE Dictionary",
  "version": "2.0",
  "description": "English to Sinhala and Sinhala to English Dictionary.",
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icon16.png",
      "32": "img/icon32.png"
    },
    "default_title": "SE Dictionary"
  },
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "permissions": ["unlimitedStorage"],
  "offline_enabled": true
}
